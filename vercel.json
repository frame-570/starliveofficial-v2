{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{1,48}[a-z0-9])",
      "destination": "/event-detail.html"
    }
  ],
  "redirects": [
    {
      "source": "/Review",
      "destination": "/review",
      "permanent": false
    },
    {
      "source": "/Promotion",
      "destination": "/promotion",
      "permanent": false
    }
  ]
}
